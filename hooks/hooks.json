{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/dist/src/sessionStart.js\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT/dist/src/sessionStart.js\"; exit $LASTEXITCODE",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/dist/src/sessionEnd.js\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT/dist/src/sessionEnd.js\"; exit $LASTEXITCODE",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/dist/src/authorizePrompt.js\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT/dist/src/authorizePrompt.js\"; exit $LASTEXITCODE",
            "timeout": 45
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|mcp__.*|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/dist/src/authorize.js\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT/dist/src/authorize.js\"; exit $LASTEXITCODE",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|mcp__.*|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/dist/src/authorizePost.js\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT/dist/src/authorizePost.js\"; exit $LASTEXITCODE",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
